#Usuario de PostgreSQL
POSTGRES_USER=tu_usuario

#Contraseña de PostgreSQL
POSTGRES_PASSWORD=tu_contrasena_segura

#Base de datos que se creará al inicializar PostgreSQL.
POSTGRES_DB=nombre_de_tu_db

#Dirección que utilizará Python más adelante, desde otro contenedor.
#Sintaxis:  =postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=postgresql://tu_usuario:tu_contrasena_segura@db:5432/nombre_de_tu_db
# NOTA: 
# - 'db' es el nombre del servicio en el compose.yaml (el DNS interno de Docker lo resuelve automáticamente).
# - '5432' es el puerto INTERNO de PostgreSQL dentro de la red de Docker.
#   La comunicación entre contenedores ocurre dentro de Docker, por lo que SIEMPRE se usa el 5432, 
#   independientemente del puerto que expongas hacia tu PC local en ports (ej: 5411:5432 o 5435:5432).
